ACADEMIC_DATA_DIR=./data
ACADEMIC_DB_PATH=./data/academic.db
# Dedicated profile; never point this at your normal Chrome profile.
# ACADEMIC_BROWSER_DIR=/absolute/path/outside/this-repository/browser
CANVAS_BROWSER_CHANNEL=chrome
SYNC_INTERVAL_MS=3600000
# IANA time zone for due-date buckets, Canvas sign-in, and Handshake event times.
# Defaults to Georgia Tech's zone; change it if you study from elsewhere.
# APER_TIME_ZONE=America/New_York

# Optional Groq key: natural-language quick capture in the command palette
# (Cmd/Ctrl+K), plus the Study Hub tutor and "Grade my work". Without a key the
# palette still saves what you typed as a plain task and the AI buttons stay hidden.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# Model for photos and handwriting (must accept image input).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Any OpenAI-compatible server, e.g. a local one or a test mock.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Handshake (Careers): read once a day by the worker, or with Refresh now.
# Reads open a visible Chrome window; Cloudflare's check never passes headless.
# HANDSHAKE_HEADLESS=1
# HANDSHAKE_DAILY_HOUR=7
# HANDSHAKE_MAX_EVENTS=30
# HANDSHAKE_DELAY_MS=700
# HANDSHAKE_EVENTS_URL=https://app.joinhandshake.com/stu/events?collection=ALL&eventFormat=HYBRID&sort=RELEVANCE&date=ALL
