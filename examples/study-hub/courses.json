          {
            "title": "Center and spread",
            "when": "Mon 8/24",
            "sec": "§2.1",
            "parts": [
              {
                "h": "The mean",
                "b": "<p>The sample mean is $\\bar{x} = \\frac{1}{n}\\sum_{i=1}^{n} x_i$. One extreme value can pull it a long way.</p>",
                "quiz": [
                  {
                    "q": "Which summary is least affected by one very large value?",
                    "type": "mc",
                    "opts": ["Mean", "Median", "Range"],
                    "a": 1,
                    "why": [
                      "The mean moves toward the outlier.",
                      "Right: the median only depends on the middle value.",
                      "The range uses the largest value directly."
                    ]
                  }
                ]
              },
              {
                "h": "Standard deviation",
                "b": "<p>The sample standard deviation is $s = \\sqrt{\\frac{1}{n-1}\\sum (x_i - \\bar{x})^2}$.</p>"
              }
            ]
          }
        ],
        "refs": [
          ["OpenIntro §2.1", "https://www.openintro.org/book/os/", "free"]
        ],
        "practice": [
          {
            "q": "Find the mean of $2, 4, 9$.",
            "type": "num",
            "a": 5,
            "hint": "Add them, then divide by how many there are.",
            "sol": "$(2+4+9)/3 = 15/3 = 5$.",
            "src": "Example set 1"
          },
          {
            "q": "What is the median of $1, 3, 3, 8, 10$?",
            "type": "mc",
            "opts": ["3", "5", "8"],
            "a": 0,
            "sol": "The middle (third) value of the sorted list is 3."
          }
        ],
        "studio": [
          {
            "title": "Compare two classes",
            "q": "Class A scored $70, 72, 74$ and class B scored $50, 72, 94$. Which class has the larger spread, and why?",
            "steps": [
              "Both means are $72$.",
              "Class B's values sit much farther from $72$.",
              "So class B has the larger standard deviation."
            ],
            "tip": "Same center does not mean same spread."
          }
        ],
        "cards": [
          {
            "f": "Sample mean formula",
            "b": "$\\bar{x} = \\frac{1}{n}\\sum x_i$"
          },
          {
            "f": "Which is robust to outliers: mean or median?",
            "b": "The median",
            "a": ["median", "the median"]
          }
        ],
        "checks": [
          "Compute a mean and a median by hand",
          "Explain why the median resists outliers"
        ],
