{
  "name": "aper",
  "version": "0.1.0",
  "description": "A local-first Georgia Tech coursework dashboard: Canvas and Gradescope in SQLite, a syllabus-aware grade calculator, study tools, and a degree planner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aarokiya/aper.git"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "canvas:login": "tsx --env-file-if-exists=.env scripts/canvas-auth.ts",
    "gradescope:login": "tsx --env-file-if-exists=.env scripts/gradescope-auth.ts",
    "handshake:login": "tsx --env-file-if-exists=.env scripts/handshake-auth.ts",
    "handshake:sync": "tsx --env-file-if-exists=.env scripts/handshake-sync.ts",
    "sync": "tsx --env-file-if-exists=.env scripts/sync.ts",
    "validate:canvas": "tsx --env-file-if-exists=.env scripts/validate-canvas.ts",
    "corpus": "tsx --env-file-if-exists=.env scripts/export-corpus.ts",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "study:import": "tsx --env-file-if-exists=.env scripts/study-import.ts",
    "planner:import": "tsx --env-file-if-exists=.env scripts/planner-import.ts",
    "profile:apply": "tsx --env-file-if-exists=.env scripts/profile-apply.ts",
    "profile:show": "tsx --env-file-if-exists=.env scripts/profile-show.ts",
    "schemas": "tsx scripts/generate-schemas.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "privacy:check": "./scripts/privacy-check.sh",
    "worker": "tsx --env-file-if-exists=.env workers/scheduler.ts",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "katex": "^0.16.47",
    "lucide-react": "1.31.0",
    "next": "^16.3.3",
    "node-html-parser": "^9.0.4",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "sanitize-html": "^2.17.7",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "ts-fsrs": "5.4.2",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
